# =====================================================================
# SecureHome SOC — custom Suricata rules
# SID range 1000000+ is reserved for local rules.
# These three families map 1:1 to the three attacks in /attacks.
# =====================================================================

# ---------------------------------------------------------------------
# 1) RECON / PORT SCANNING  (attacks/01-recon-nmap.md)
#    Many SYNs to many ports from one host in a short window.
# ---------------------------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"SECUREHOME Nmap-style TCP SYN scan (horizontal/vertical)"; \
    flags:S; flow:to_server; \
    threshold:type both, track by_src, count 30, seconds 5; \
    classtype:attempted-recon; sid:1000001; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"SECUREHOME TCP NULL scan"; \
    flags:0; classtype:attempted-recon; sid:1000002; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"SECUREHOME TCP XMAS scan"; \
    flags:FPU; classtype:attempted-recon; sid:1000003; rev:1;)

# ---------------------------------------------------------------------
# 2) SSH BRUTE FORCE  (attacks/02-ssh-bruteforce.md)
#    Repeated new connections to tcp/22 from one source = password guessing.
# ---------------------------------------------------------------------
alert tcp any any -> $HOME_NET 22 (msg:"SECUREHOME SSH brute-force (many new connections)"; \
    flow:to_server; flags:S; \
    threshold:type both, track by_src, count 10, seconds 20; \
    classtype:attempted-admin; sid:1000010; rev:1;)

# ---------------------------------------------------------------------
# 3) DNS TUNNELING  (attacks/03-dns-tunnel.md)
#    Data smuggled inside DNS: abnormally long query names, lots of TXT
#    lookups, or very high query volume to one domain.
#    (This ties directly into my DNS-tunnel detection research.)
# ---------------------------------------------------------------------
# a) Very long DNS query name (tunnels encode data into the label).
alert dns any any -> any any (msg:"SECUREHOME Possible DNS tunnel - oversized query name"; \
    dns.query; dns.query.length:>60; \
    threshold:type both, track by_src, count 5, seconds 10; \
    classtype:policy-violation; sid:1000020; rev:1;)

# b) High rate of TXT-record queries (common tunnel carrier).
alert dns any any -> any any (msg:"SECUREHOME Possible DNS tunnel - TXT query flood"; \
    dns.query; dns.opcode:0; \
    content:"|00 10 00 01|"; \
    threshold:type both, track by_src, count 20, seconds 30; \
    classtype:policy-violation; sid:1000021; rev:1;)

# c) High overall DNS query volume from one internal host.
alert dns $HOME_NET any -> any any (msg:"SECUREHOME DNS query flood from internal host"; \
    dns.query; \
    threshold:type both, track by_src, count 100, seconds 10; \
    classtype:policy-violation; sid:1000022; rev:1;)

# ---------------------------------------------------------------------
# 4) SEGMENTATION VIOLATION (bonus)
#    Any IoT host trying to reach the Servers VLAN should NEVER happen
#    (the ACL blocks it) — if Suricata sees it, something is wrong.
# ---------------------------------------------------------------------
alert ip 10.10.30.0/24 any -> 10.10.20.0/24 any (msg:"SECUREHOME Segmentation violation: IoT -> SERVERS"; \
    classtype:policy-violation; sid:1000030; rev:1;)
